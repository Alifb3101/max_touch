# Copy this file to `.env.local` and fill in the real values.

# Public URL of the website (no trailing slash). Used for SEO canonical URLs,
# sitemap, Open Graph and auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:8443

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Secret used by /api/revalidate to refresh cached pages after catalog edits.
REVALIDATE_SECRET=change-me-to-a-long-random-string
